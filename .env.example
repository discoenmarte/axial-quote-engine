# Optional. When set, messages the deterministic rules cannot interpret confidently
# are sent to Claude for interpretation. The model never picks SKUs or quotes.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# Where state lives (survives process restarts). Default: ./data/axial.db
# AXIAL_DB_PATH=./data/axial.db
